{
  "name": "studentshield",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --import ./test/setup.js --test --test-concurrency=1 test/*.test.js",
    "bootstrap": "node --env-file-if-exists=.env src/bootstrap.js",
    "maintenance": "node --env-file-if-exists=.env src/maintenance.js",
    "mail": "node --env-file-if-exists=.env src/read-mail.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.7",
    "otpauth": "^9.5.2",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "description": "StudentShield local-file edition \u2014 no database or Docker required"
}
