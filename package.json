{
  "name": "studentshield",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "bootstrap": "node --env-file-if-exists=.env src/bootstrap.js",
    "maintenance": "node --env-file-if-exists=.env src/maintenance.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.7",
    "otpauth": "^9.5.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
