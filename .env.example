# Optional: npm install and npm run dev work without a .env file.
PORT=8080
APP_URL=http://localhost:8080
HOST=127.0.0.1
NODE_ENV=development
DATA_DIR=./data
# Keys are generated and retained automatically in data/keys.json.
# SESSION_SECRET=
# DATA_ENCRYPTION_KEY=
# file: local test inbox; read with npm run mail. smtp: real delivery.
MAIL_MODE=file
