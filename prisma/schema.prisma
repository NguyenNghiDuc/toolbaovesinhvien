generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}
model School {
  id String @id @default(cuid())
  name String
  code String @unique
  contactEmail String?
  settings Json @default("{}")
  users User[]
  createdAt DateTime @default(now())
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  avatar String @default("shield")
  passwordHash String
  role Role @default(USER)
  schoolId String?
  school School? @relation(fields: [schoolId], references: [id])
  verified Boolean @default(false)
  disabled Boolean @default(false)
  totpSecret String?
  totpLastStep BigInt?
  recoveryHashes String[] @default([])
  sessionVersion Int @default(0)
  createdAt DateTime @default(now())
  tokens Token[]
  accounts ProtectedAccount[]
  events SecurityEvent[]
  completions Completion[]
}
model Token {
  id String @id @default(cuid())
  hash String @unique
  kind String
  expiresAt DateTime
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model ProtectedAccount {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  label String
  email String
  has2fa Boolean @default(false)
  uniquePassword Boolean @default(false)
  recoveryReady Boolean @default(false)
  createdAt DateTime @default(now())
}
model SecurityEvent {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  type String
  ip String
  agent String
  createdAt DateTime @default(now())
}
model Lesson {
  schoolId String?
  id String @id @default(cuid())
  title String
  content String
  completions Completion[]
}
model Completion {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, lessonId])
}
model SystemPolicy {
  id String @id @default("global")
  minPasswordLength Int @default(12)
  maxFailedLogins Int @default(10)
  sessionHours Int @default(8)
}
model Session {
  sid String @id @db.VarChar
  sess Json @db.Json
  expire DateTime @db.Timestamp(6)
  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
