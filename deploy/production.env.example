# Copy OUTSIDE the checkout to /secure/studentshield.env, chmod 600, fill values.
STUDENTSHIELD_ENV_FILE=/secure/studentshield.env
STUDENTSHIELD_DOMAIN=studentshield.example.com
APP_URL=https://studentshield.example.com
NODE_ENV=production
PORT=8080
POSTGRES_PASSWORD=
# URL-encode the same POSTGRES_PASSWORD in this URL; keep host db.
DATABASE_URL=postgresql://studentshield:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/studentshield
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
EVENT_RETENTION_DAYS=90
